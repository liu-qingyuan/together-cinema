<!doctype html>
<html lang="$lang">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>$title · Together Cinema</title>
<meta name="description" content="$lead">
<link rel="stylesheet" href="${base}assets/site.css">
</head><body>
<main>
<section class="cover" aria-labelledby="title">
  <picture class="sky" aria-hidden="true"><source media="(max-width:640px) and (orientation:portrait)" srcset="${base}assets/v1-sky-mobile.webp"><img src="${base}assets/v1-sky-desktop.webp" alt="" width="1280" height="720" fetchpriority="high"></picture>
  <header class="mast"><span class="brand"><span class="mark" aria-hidden="true">▷</span> Together Cinema</span><a class="lang" href="$other" hreflang="$other_lang" lang="$other_lang">$language</a></header>
  <div class="opening"><p class="eyebrow light">$project &nbsp; / &nbsp; VOL. 01</p><h1 id="title"><span>$line1</span><span>$line2</span></h1><p class="lead">$lead</p><nav><a class="pill" href="$install">$host ↗</a><a class="ghost" href="$guide">$watch →</a></nav></div>
  <a class="scroll" href="#tour"><span>$walk</span><span aria-hidden="true">01 — 03 &nbsp; ↓</span></a>
</section>

<div id="tour" class="tour">
<section class="feature" aria-labelledby="join"><div class="story"><p class="eyebrow">01 &nbsp; / &nbsp; $entryLabel</p><h2 id="join">$entryTitle</h2><p>$entryText</p><p class="aside">$entryNext</p></div>
<figure class="frame mint"><a href="${base}assets/$lang-entry.webp"><img class="entry" src="${base}assets/$lang-entry.webp" alt="$entryAlt" loading="lazy" decoding="async"></a><figcaption>FIG. 01 &nbsp; / &nbsp; $entryLabel</figcaption></figure></section>
<section class="feature reverse" aria-labelledby="pick"><div class="story"><p class="eyebrow">02 &nbsp; / &nbsp; $libraryLabel</p><h2 id="pick">$libraryTitle</h2><p>$libraryText</p><p class="aside">$libraryNext</p></div>
<figure class="frame peach"><a href="${base}assets/$lang-library.webp"><img src="${base}assets/$lang-library.webp" alt="$libraryAlt" loading="lazy" decoding="async"></a><figcaption>FIG. 02 &nbsp; / &nbsp; $libraryLabel</figcaption></figure></section>
</div>

<section class="signal" aria-labelledby="modes"><div class="inner"><p class="eyebrow">03 &nbsp; / &nbsp; $modeLabel</p><h2 id="modes">$modeTitle</h2><p class="intro">$modeIntro</p>
<div class="pair"><article><p class="eyebrow">A &nbsp; / &nbsp; DIRECT</p><h3>$directTitle</h3><p><strong>$directWhen</strong> $directText</p><a href="${base}assets/$lang-direct.webp"><img src="${base}assets/$lang-direct.webp" alt="$directAlt" loading="lazy" decoding="async"></a></article>
<article><p class="eyebrow">B &nbsp; / &nbsp; RELAY</p><h3>$relayTitle</h3><p><strong>$relayWhen</strong> $relayText</p><a href="${base}assets/$lang-relay.webp"><img src="${base}assets/$lang-relay.webp" alt="$relayAlt" loading="lazy" decoding="async"></a></article></div>
<a class="guide" href="$guide#modes">$more →</a></div></section></main>
<footer><div class="foot"><strong>Together Cinema</strong><nav><a href="$install">$host</a><a href="$guide">$watch</a><a href="$arch">$archLabel</a><a href="$repo">GitHub ↗</a></nav><p>$footer</p><small><a href="https://unicorncreates.itch.io/sky-backgrounds">$credit</a> · <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a></small></div></footer>
</body></html>
